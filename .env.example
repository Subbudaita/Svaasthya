# Copy to .env and fill in. Never commit .env. No value here is real.

# --- Local database (compose.yaml) -------------------------------------------
# Admin / schema-owner credentials for the local Postgres container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=swasthya
POSTGRES_PORT=5432
# Password for the swasthya_api login role created on first boot
# (infra/db/create_roles.sql).
SWASTHYA_API_DB_PASSWORD=

# --- API (apps/api) ------------------------------------------------------------
# local | test | production
SWASTHYA_ENV=local

# Runtime connection: the RLS-bound swasthya_api role. Must use postgresql+psycopg://.
# The API refuses to start if this role is a superuser or has BYPASSRLS.
DATABASE_URL=postgresql+psycopg://swasthya_api:<SWASTHYA_API_DB_PASSWORD>@localhost:5432/swasthya

# Schema-owner connection used ONLY by `alembic upgrade`. Never given to the API.
MIGRATIONS_DATABASE_URL=postgresql+psycopg://postgres:<POSTGRES_PASSWORD>@localhost:5432/swasthya

# Supabase project URL, e.g. https://<project-ref>.supabase.co
# Used to fetch the JWKS that verifies access tokens (asymmetric signing keys).
SUPABASE_URL=
# Legacy HS256 JWT secret. If set, it is used INSTEAD of the JWKS. Leave empty
# for projects on asymmetric signing keys. With neither set, every request is 503.
SUPABASE_JWT_SECRET=
# Expected `aud` claim on Supabase access tokens.
SUPABASE_JWT_AUDIENCE=authenticated

# Hard per-user daily token cap (input + output), reset at the user's local midnight.
# users.daily_token_cap overrides it per user.
DAILY_TOKEN_CAP=300000

# IANA timezone given to new users until onboarding records theirs.
DEFAULT_TIMEZONE=Asia/Kolkata

# JSON list of browser origins allowed to call the API, e.g. ["http://localhost:3000"]
CORS_ALLOW_ORIGINS=[]

# Optional: point at a different data/ directory (defaults to the repo's data/).
SWASTHYA_DATA_DIR=

# --- Perception (Phase 1) ------------------------------------------------------
# Anthropic API key (console.anthropic.com → Settings → API Keys). Without it,
# photo and text logging return 503; "same as yesterday" and quick-picks still work.
ANTHROPIC_API_KEY=
# Effort for the plate agent: low | medium | high | xhigh | max. "low" keeps the
# photo reply inside the 15 s budget; raise it if the vision eval says accuracy needs it.
PLATE_AGENT_EFFORT=low
# Where plate photos are stored (local disk until Supabase Storage is connected).
PHOTO_STORAGE_DIR=var/photos

# --- Telegram (Phase 1) --------------------------------------------------------
# Bot token from @BotFather. Locally, run `make telegram` (long polling).
TELEGRAM_BOT_TOKEN=
# Webhook mode only (deployed): a random string you also pass to setWebhook as
# secret_token. Leave empty for polling.
TELEGRAM_WEBHOOK_SECRET=

# --- Tests ---------------------------------------------------------------------
# Optional: an EMPTY admin database for pytest instead of testcontainers, e.g.
# postgresql+psycopg://postgres:<POSTGRES_PASSWORD>@localhost:5432/swasthya_test
# The suite creates and drops its own roles and tables there.
TEST_DATABASE_URL=

# --- Web (apps/web) ------------------------------------------------------------
# Base URL of the API as seen from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000
