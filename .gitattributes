# Keep Unix line endings for anything that runs inside Linux containers or
# is read byte-for-byte, even when the repo is checked out on Windows.
* text=auto
*.sh text eol=lf
*.sql text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
Makefile text eol=lf
*.ps1 text eol=crlf
